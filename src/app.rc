#include <windows.h>
#include "resource.h"

/* Application icon */
IDR_APP_ICON ICON "app.ico"

/* Manifest (common controls v6, DPI awareness, supported OS) */
1 24 "app.manifest"

/* ------------------------------------------------------------------ settings */
IDD_SETTINGS DIALOGEX 0, 0, 272, 162
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Appearance", IDC_STATIC, 7, 7, 258, 66
    AUTORADIOBUTTON "Follow Windows setting", IDC_THEME_SYSTEM, 18, 23, 220, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Light",                  IDC_THEME_LIGHT,  18, 38, 220, 10
    AUTORADIOBUTTON "Dark",                   IDC_THEME_DARK,   18, 53, 220, 10

    AUTOCHECKBOX    "Always run as administrator", IDC_RUN_ADMIN, 10, 82, 240, 10, WS_TABSTOP
    LTEXT           "Restarts the app elevated (UAC prompt) so installers that need administrator rights succeed.", IDC_SETTINGS_HINT, 20, 95, 244, 20

    DEFPUSHBUTTON   "OK",     IDOK,     150, 140, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 208, 140, 52, 15
END

/* ------------------------------------------------------------------ message box */
/* Custom replacement for MessageBoxW: native message boxes stay partly light
   in dark mode no matter how they are themed, so all prompts use this dialog,
   painted entirely by main.cpp (text + dynamic buttons). */
IDD_MSGBOX DIALOGEX 0, 0, 244, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_NOIDLEMSG | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_MSG_TEXT,14,8,216,68
    PUSHBUTTON      "",IDC_MSG_BTN1,14,80,72,14
    PUSHBUTTON      "",IDC_MSG_BTN2,90,80,72,14
    PUSHBUTTON      "",IDC_MSG_BTN3,166,80,64,14
END

/* ------------------------------------------------------------------ version */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Portable"
            VALUE "FileDescription",  "Winget Update Manager"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WingetGUI"
            VALUE "LegalCopyright",   "Free to use"
            VALUE "OriginalFilename", "WingetGUI.exe"
            VALUE "ProductName",      "Winget Update Manager"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END